#!/usr/bin/env bash
# Blocks commit if staged renames have unresolved references in tracked files.
# Fix with: /bob-fix-references (Claude Code) or bob-fix-references/fix.sh <repo>

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

# Get renamed pairs from staged and unstaged changes
renames=$(
  { git diff --cached --diff-filter=R --name-status
    git diff --diff-filter=R --name-status; } \
  | awk '{print $2 "\t" $3}' | sort -u
)

[[ -z "$renames" ]] && exit 0

# Find the first path segment that differs between old and new path.
# E.g. commands/ai-review-command/foo.py → commands/bob-review-command/foo.py
# returns "ai-review-command", not "foo.py".
changed_segment() {
  local old="$1" new="$2"
  local IFS='/'
  read -ra old_parts <<< "$old"
  read -ra new_parts <<< "$new"
  local i
  for i in "${!old_parts[@]}"; do
    if [[ "${old_parts[$i]}" != "${new_parts[$i]:-}" ]]; then
      echo "${old_parts[$i]}"
      return
    fi
  done
  basename "$old"
}

found_any=0
declare -A seen_segments=()

while IFS=$'\t' read -r old_path new_path; do
  old_seg=$(changed_segment "$old_path" "$new_path")
  # Deduplicate: skip if we already checked this segment (e.g. dir with multiple renamed files)
  [[ -n "${seen_segments[$old_seg]:-}" ]] && continue
  seen_segments[$old_seg]=1

  # Skip if old segment still has tracked files under it (partial move, not a full rename)
  still_exists=$(git -C "$repo_root" ls-files | grep -m1 "/$old_seg/" || true)
  [[ -n "$still_exists" ]] && continue

  hits=$(git -C "$repo_root" grep --cached -l "$old_seg" 2>/dev/null || true)
  if [[ -n "$hits" ]]; then
    if [[ $found_any -eq 0 ]]; then
      echo ""
      echo "  COMMIT BLOCKED — unresolved references after rename"
      echo ""
    fi
    found_any=1
    echo "  Renamed segment: $old_seg  (e.g. $old_path → $new_path)"
    echo "  Stale references in:"
    while IFS= read -r hit; do
      echo "    $hit"
    done <<< "$hits"
    echo ""
  fi
done <<< "$renames"

if [[ $found_any -eq 1 ]]; then
  echo "  Fix with: /bob-fix-references"
  echo ""
  exit 1
fi

# Dead reference scan — check all ~/.claude/ paths referenced in tracked files
dead_refs=$(git ls-files | grep -v 'dev_tasks_closed' | xargs grep -hEo '~/.claude/[^`" )]+' 2>/dev/null | grep -vE '<|>|\[|\.\.\.' | sort -u | while read -r p; do
  [[ -e "${p/\~/$HOME}" ]] || echo "  $p"
done || true)

if [[ -n "$dead_refs" ]]; then
  echo ""
  echo "  COMMIT BLOCKED — dead ~/.claude/ references found"
  echo ""
  echo "$dead_refs"
  echo ""
  echo "  Fix with: /bob-fix-references"
  echo ""
  exit 1
fi

exit 0
